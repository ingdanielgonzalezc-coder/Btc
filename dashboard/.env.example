# Links CSV publicados de cada pestaña del Google Sheet.
# En la planilla: Archivo → Compartir → Publicar en la web → elige la pestaña → CSV → Publicar.
# Cada pestaña tiene su propio link (cambia el gid). Los que falten se pueden pegar
# después en la app (botón «Fuentes de datos»), pero solo quedan en ese navegador.
VITE_CSV_V21=        # track_record_v21  (registro oficial)
VITE_CSV_V3=         # track_record_v3   (challenger)
VITE_CSV_V20=        # track_record      (legado)
VITE_CSV_META=       # meta_runs         (salud de v2.1 y brecha de ejecución)
VITE_CSV_META_V3=    # meta_runs_v3
VITE_CSV_LEVELS=     # next_levels       (precios de giro, lo escribe daily_levels.py)
VITE_CSV_EXEC=       # track_record_exec (v2.1 y V3 ejecutando a las 05:00 UTC; daily_run_exec.py)

# Compatibilidad: si solo está VITE_CSV_URL, se usa como v2.1. Si en realidad apunta
# a otra pestaña, la app la detecta por sus columnas, la reasigna y avisa.
VITE_CSV_URL=
